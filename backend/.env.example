# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Model tiers (fallbacks are tried in order on rate limits / outages)
MODEL_FAST=gemini-3.5-flash-lite
MODEL_SMART=gemini-3-flash-preview
MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-flash-lite-latest
EMBED_MODEL=gemini-embedding-001
# Browser origins allowed to call the API: your Vercel URL (exact, no trailing slash) + local dev
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# Optional: also allow Vercel preview deployments of this project
CORS_ORIGIN_REGEX=
# Cache identical LLM requests (reproducible evaluations, saves free-tier quota)
LLM_CACHE=true
# MCP transport between the agents and the tool server: stdio | inprocess
MCP_MODE=stdio
# Optional: require this code (X-Access-Code header) to start runs / upload documents
ACCESS_CODE=
RUNS_PER_HOUR_PER_IP=20
MAX_CONCURRENT_RUNS=2
# Optional e-mail for the OpenAlex polite pool
CONTACT_EMAIL=
# Optional free OpenAlex key (https://openalex.org/settings/api): 10x higher daily search budget
OPENALEX_API_KEY=
