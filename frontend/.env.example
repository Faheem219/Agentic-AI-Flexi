# Your backend's public origin (the domain Nginx serves for the API).
# No trailing slash and no /api - the app adds /api/... itself. Example:
#   VITE_API_BASE=https://api.example.com
# On Vercel: Project Settings -> Environment Variables. It is baked in at build time,
# so redeploy after changing it. Leave empty for local development (Vite proxies /api to :8000).
VITE_API_BASE=
